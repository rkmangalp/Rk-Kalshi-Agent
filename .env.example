# Copy to .env (gitignored) or set these in your shell.
# Connecting is not live trading. Enable Live only from the dashboard
# after Connect + the real-money confirmation. Never paste keys into the UI.
# Losses on the live path are real.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=C:\Users\Rk\.kalshi\kalshi.key
# Optional PEM instead of a file path (prefer the path):
# KALSHI_PRIVATE_KEY=
KALSHI_ENVIRONMENT=prod
# prod  → https://external-api.kalshi.com/trade-api/v2
# demo  → https://external-api.demo.kalshi.co/trade-api/v2
# Optional override:
# KALSHI_BASE_URL=

# Optional ChatGPT paper-research path (signal.mode = llm or hybrid).
# Never paste this in the UI. LLM research is slow vs the book and is
# not a guaranteed edge.
# OPENAI_API_KEY=sk-...
